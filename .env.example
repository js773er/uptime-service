# --- Clerk (https://dashboard.clerk.com) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# --- AWS (used by the Next.js app to reach DynamoDB) ---
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Output of `npm run deploy` (UptimeServiceStack.TableName)
TABLE_NAME=

# --- Alerting (read at deploy time by `npm run deploy`) ---
RESEND_API_KEY=re_...
# Must be a sender verified in Resend; the default onboarding sender works for testing
ALERT_FROM_EMAIL=Uptime <onboarding@resend.dev>
# Fallback recipient when a monitor has no alertEmail
ALERT_FALLBACK_EMAIL=

# --- AI features (optional; read at deploy time) ---
# Without a key, content checking and alert correlation are simply skipped.
ANTHROPIC_API_KEY=sk-ant-...
# Optional model override (defaults to claude-opus-5)
ANTHROPIC_MODEL=
